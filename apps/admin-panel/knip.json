{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "src/main.tsx",
    "api/**/*.ts",
    "scripts/build-vault-json.mjs",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "api/**/*.ts"],
  "ignore": ["src/**/*.d.ts"],
  "ignoreBinaries": ["clasp"],
  "vitest": {
    "config": ["vite.config.ts", "vitest.config.ts"],
    "entry": ["src/**/*.{test,spec}.{ts,tsx}"]
  }
}
