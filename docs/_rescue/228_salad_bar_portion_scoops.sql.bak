-- Vegetables (large portion)
UPDATE public.salad_bar_slots s SET portion_grams = 150, portion_tool = 'scoop_#6'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'PF-BAKED_BEETROOT';

