-- 228: Add portion size and tool to salad bar slots
-- Each cell gets a dedicated scoop/tool — assembler does "1 scoop = 1 portion"
-- Standardized: same ingredient = same portion weight in every salad

-- ─── Schema ─────────────────────────────────────────────
ALTER TABLE public.salad_bar_slots
  ADD COLUMN IF NOT EXISTS portion_grams NUMERIC(6,1),
  ADD COLUMN IF NOT EXISTS portion_tool  TEXT;

COMMENT ON COLUMN public.salad_bar_slots.portion_grams IS 'Standard portion weight in grams (one scoop/grab = this many grams)';
COMMENT ON COLUMN public.salad_bar_slots.portion_tool  IS 'Portioning tool: tongs, scoop_#6..#60, tbsp, pieces_N';

-- ─── Populate by ingredient (via nomenclature join) ─────
-- Update slots that have ingredient_id assigned

-- Bases (tongs — one grab)
UPDATE public.salad_bar_slots s SET portion_grams = 120, portion_tool = 'tongs'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'PF-SALAD_BASE_CRISPY';

UPDATE public.salad_bar_slots s SET portion_grams = 100, portion_tool = 'tongs'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'PF-SALAD_BASE_SUPERFOOD';

-- Vegetables (scoops)
UPDATE public.salad_bar_slots s SET portion_grams = 40, portion_tool = 'scoop_#24'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'RAW-CHERRY-TOMATO';

UPDATE public.salad_bar_slots s SET portion_grams = 40, portion_tool = 'scoop_#24'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'RAW-CUCUMBER';

UPDATE public.salad_bar_slots s SET portion_grams = 20, portion_tool = 'scoop_#40'
