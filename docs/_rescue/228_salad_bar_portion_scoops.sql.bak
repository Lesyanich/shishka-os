  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'RAW-RADISH';

UPDATE public.salad_bar_slots s SET portion_grams = 10, portion_tool = 'tbsp'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'RAW-RED_ONION';

UPDATE public.salad_bar_slots s SET portion_grams = 5, portion_tool = 'tbsp'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'RAW-PARSLEY';

UPDATE public.salad_bar_slots s SET portion_grams = 5, portion_tool = 'tbsp'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'RAW-SPRING-ONION';

UPDATE public.salad_bar_slots s SET portion_grams = 5, portion_tool = 'tbsp'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'RAW-DILL';

-- Proteins
UPDATE public.salad_bar_slots SET portion_grams = 80, portion_tool = 'scoop_#10'
  WHERE display_name = 'Chicken' AND ingredient_id IS NULL;  -- no ingredient_id yet

UPDATE public.salad_bar_slots s SET portion_grams = 50, portion_tool = 'tongs'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'RAW-SMOKED_TROUT';

UPDATE public.salad_bar_slots s SET portion_grams = NULL, portion_tool = 'pieces_2'
  FROM nomenclature n WHERE n.id = s.ingredient_id AND n.product_code = 'RAW-EGG';

-- Grains
UPDATE public.salad_bar_slots s SET portion_grams = 40, portion_tool = 'scoop_#24'
